<section id="section-contacto">
  <div class="container">

    <h2>Contacto</h2>
    <p>Completa el formulario y nos pondremos en contacto contigo a la brevedad.</p>

    <div class="feedback-banner" role="alert" aria-live="polite">
      <p class="feedback-banner-message"></p>
      <button type="button" class="feedback-banner-close" aria-label="Cerrar mensaje">
        &times;
      </button>
    </div>

    <form
      id="contact-form"
      action="/contacto"
      method="POST"
      novalidate
    >
      <input
        type="hidden"
        id="csrf-token-field"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <div class="form-field">
        <label class="form-label" for="field-nombre">Nombre</label>
        <input
          class="form-input"
          type="text"
          id="field-nombre"
          name="nombre"
          autocomplete="name"
          aria-describedby="error-nombre"
          required
        >
        <span
          class="field-error-msg"
          id="error-nombre"
          role="alert"
        >
          Ingresa tu nombre (mínimo 2 caracteres).
        </span>
      </div>

      <div class="form-field">
        <label class="form-label" for="field-email">Correo electrónico</label>
        <input
          class="form-input"
          type="email"
          id="field-email"
          name="email"
          autocomplete="email"
          aria-describedby="error-email"
          required
        >
        <span
          class="field-error-msg"
          id="error-email"
          role="alert"
        >
          Ingresa un correo electrónico válido.
        </span>
      </div>

      <div class="form-field">
        <label class="form-label" for="field-mensaje">Mensaje</label>
        <textarea
          class="form-input"
          id="field-mensaje"
          name="mensaje"
          rows="5"
          autocomplete="off"
          aria-describedby="error-mensaje"
          required
        ></textarea>
        <span
          class="field-error-msg"
          id="error-mensaje"
          role="alert"
        >
          El mensaje debe tener al menos 10 caracteres.
        </span>
      </div>

      <button
        type="submit"
        class="btn-primary"
      >
        Enviar mensaje
      </button>

    </form>

  </div>
</section>