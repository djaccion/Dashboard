# Copia este archivo como .env y completa los valores reales. NUNCA subas .env al repositorio.

# ─── SERVIDOR ────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── SEGURIDAD ───────────────────────────────────────────
CSRF_SECRET=cambia_este_valor_por_un_string_aleatorio_de_32_caracteres

# ─── EMAIL (NODEMAILER) ──────────────────────────────────
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@ejemplo.com
SMTP_PASS=tu_contrasena_smtp
MAIL_FROM=tu_correo@ejemplo.com
MAIL_TO=destinatario@ejemplo.com

# ─── LOGGING ─────────────────────────────────────────────
LOG_FILE_PATH=logs/app.log